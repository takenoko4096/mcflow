{
    "name": "tree-sitter-mcflow",
    "version": "0.1.0",
    "description": "Mcflow grammar for tree-sitter",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/takenoko4096/mcflow.git"
    },
    "funding": "",
    "license": "MIT",
    "author": {
        "name": "takenoko4096",
        "url": ""
    },
    "main": "bindings/node",
    "types": "bindings/node",
    "keywords": [
        "incremental",
        "parsing",
        "tree-sitter",
        "mcflow"
    ],
    "files": [
        "grammar.js",
        "tree-sitter.json",
        "binding.gyp",
        "prebuilds/**",
        "queries/*",
        "mcflow/src/**",
        "*.wasm"
    ],
    "dependencies": {},
    "devDependencies": {
        "prebuildify": "^6.0.1",
        "tree-sitter": "^0.25.0",
        "tree-sitter-cli": "^0.27.2"
    },
    "peerDependencies": {
        "tree-sitter": "^0.25.0"
    },
    "peerDependenciesMeta": {
        "tree-sitter": {
            "optional": true
        }
    },
    "scripts": {
        "prestart": "tree-sitter build --wasm",
        "start": "tree-sitter playground",
        "test": "node --test bindings/node/*_test.js",
        "generate-then-build": "tree-sitter generate && tree-sitter build -o \"./build/tree-sitter-mcflow.dll\""
    }
}
