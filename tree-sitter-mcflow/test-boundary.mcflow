
# ============================================================
# 01. Line comment boundaries
# ============================================================

# A line comment containing block-comment delimiters:
#:: this is NOT a block comment ::#

# A line comment containing comment-command syntax:
#/ this is NOT a comment command

# A line comment containing line-continuation syntax:
# this is not a continuation: \

say after line comments


# ============================================================
# 02. Block comment boundaries
# ============================================================

#:: block comment containing line-comment syntax:
# this is NOT a line comment
::#

#:: block comment containing comment-command syntax:
#/ this is NOT a comment command
::#

#:: block comment containing continuation syntax:
\
    this is NOT a continuation
::#

#:: block comment containing nested-looking delimiters:
    #/ not a comment command
    # ordinary-looking line comment
    #:: nested block ::#
    ::#
::#

say after block comment boundaries


# ============================================================
# 03. Block comments adjacent to command boundaries
# ============================================================

#:: comment ::# say command
say command #:: comment ::#

say before #:: multiline
comment
::# after

#:: comment ::#
say separate command

say command #:: comment ::#
#:: another comment ::#
say another command


# ============================================================
# 04. Empty and minimal comment commands
# ============================================================

#/
#/
#/
say after empty comment commands

say before \
    #/
    say after continuation

say before \
    #/
    say after continuation with whitespace


# ============================================================
# 05. Quoted-string boundaries
# ============================================================

say ""
say " "
say "#"
say "#/"
say "#::"
say "::#"
say "\\"
say "\""
say "quoted string ending with escaped backslash: \\"

say before "quoted #/ content" after
say before "quoted #:: content ::#" after
say before "quoted \\" escaped quote" after


# ============================================================
# 06. Unterminated quoted strings
# ============================================================

say "unterminated string
say this is a new physical line

say "unterminated string at EOF


# ============================================================
# 07. Unterminated block comments
# ============================================================

say before #:: unterminated block comment

#:: unterminated block comment at EOF


# ============================================================
# 08. Line continuation at EOF
# ============================================================

say command ending with continuation \

say another command

say command with multiple continuations \
    \
    \

say final command


# ============================================================
# 09. Empty and whitespace-only input regions
# ============================================================







say after whitespace-only region


# ============================================================
# 10. Special characters in comment commands
# ============================================================

#/ #:: ::# #/ "quoted" \
#/ multiple \ backslashes \\ \\\
#/ trailing # characters ###

say after comment commands


# ============================================================
# 11. Mixed comments and continuations
# ============================================================

say first \
    # ordinary comment containing #:: and #/
    #:: block comment ::#
    #/ comment command
    second

say first \
    #:: block
       comment
    ::#
    \
    # ordinary comment
    \
    #/ comment command
    third


# ============================================================
# 12. Final command
# ============================================================

say final command without trailing newline
