
# ============================================================
# 01. Basic commands and horizontal whitespace
# ============================================================

say hello
give @s apple
summon allay ~ ~ ~

say    multiple   spaces
say	multiple	tabs
give @s apple # trailing line comment
give @s # comment between arguments
    give @s apple


# ============================================================
# 02. Block comments
# ============================================================

#:: standalone block comment ::#

say before #:: inline block comment ::# after

give @s #:: comment between arguments ::# apple

#:: multiline
   block comment
::#

say after multiline block comment

#:: outer block
    #:: nested block ::#
    still inside outer block
::#

say after nested block comment

#:: outer
    #:: nested
        #:: deeply nested ::#
    ::#
still inside outer
::#

say after deeply nested block comment


# ============================================================
# 03. Quoted strings
# ============================================================

say "ordinary quoted string"
say "hash # is not a comment"
say "comment command #/ is not a comment"
say "block comment #:: is not a comment"
say "escaped quote: \" still inside the string"
say "backslash before ordinary character: \x"
say "multiple spaces    are preserved"

say "quoted string with #:: nested-looking #:: content ::#"


# ============================================================
# 04. Line continuations
# ============================================================

say first \
    second

say first \

    second

say first \
    # comment between continued lines
    second

say first \
    #:: block comment
       spanning multiple lines
    ::#
    second

say first \
    # comment one
    # comment two
    # comment three
    second

say first \
    #/ comment command inside continuation
    second

say first \
    #/ first comment command
    #/ second comment command
    second

say first \
    #:: block comment
    ::#
    #/ comment command after block comment
    second


# ============================================================
# 05. Multiple continuation chains
# ============================================================

say first \
    second \
    third \
    fourth

say first \
    #/ comment command
    second \
    # ordinary comment
    third \
    #:: block comment ::#
    fourth


# ============================================================
# 06. Comment commands
# ============================================================

#/ standalone comment command
#/ comment command with # and #:: and \
#/ comment command with "quoted text"

say after standalone comment commands

#/ comment command containing multiple special characters: #/ #:: ::# \ "


# ============================================================
# 07. Boundary cases
# ============================================================

# A comment command immediately following ordinary command text.
# Check whether this should be a child comment_command or a line comment.
say command before #/ same-line comment command

say command after same-line comment command

# A comment command ending with a backslash must not continue.
#/ comment command ending with \
say this should be a separate command

# A backslash not followed by a newline is ordinary command text.
say backslash\without-newline

# A backslash at the beginning of a command.
\ say this starts with a backslash


# ============================================================
# 08. End-of-file boundaries
# ============================================================

say final command
