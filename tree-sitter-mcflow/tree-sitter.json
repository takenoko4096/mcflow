{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "mcflow",
            "camelcase": "Mcflow",
            "title": "Mcflow",
            "scope": "source.mcflow",
            "file-types": ["mcflow"],
            "injection-regex": "^mcflow$",
            "class-name": "TreeSitterMcflow"
        },
        {
            "name": "mcfunction",
            "camelcase": "McFunction",
            "title": "McFunction",
            "scope": "source.mcfunction",
            "file-types": ["mcfunction"],
            "injection-regex": "^mcfunction$",
            "class-name": "TreeSitterMcFunction"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "MIT",
        "description": "Mcflow grammar for tree-sitter",
        "authors": [
            {
                "name": "takenoko4096",
                "url": "https://github.com/takenoko4096"
            }
        ],
        "links": {
            "repository": "https://github.com/takenoko4096/mcflow"
        }
    },
    "bindings": {
        "c": false,
        "go": false,
        "java": true,
        "node": false,
        "python": false,
        "rust": false,
        "swift": false,
        "zig": false
    }
}
