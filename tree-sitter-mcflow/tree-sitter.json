{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mcflow",
      "camelcase": "Mcflow",
      "title": "Mcflow",
      "scope": "source.mcflow",
      "file-types": [
        "mcflow",
        "mcfunction"
      ],
      "injection-regex": "^mcflow$",
      "class-name": "TreeSitterMcflow"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Mcflow grammar for tree-sitter",
    "authors": [
      {
        "name": "takenoko4096",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/takenoko4096/mcflow",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": true,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}