{
    "name": "mcflow",
    "displayName": "mcflow",
    "description": "High-precision command language server for Minecraft Bedrock Edition",
    "version": "0.1.0",
    "icon": "icon.png",
    "publisher": "takenoko4096",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/takenoko4096/mcflow"
    },
    "bugs": {
        "url": "https://github.com/takenoko4096/mcflow/issues"
    },
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "mcfunction",
                "aliases": [
                    "Minecraft Function",
                    "mcfunction"
                ],
                "extensions": [
                    ".mcfunction"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "mcflow",
                "aliases": [
                    "Minecraft Command Flow",
                    "mcflow"
                ],
                "extensions": [
                    ".mcflow"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mcfunction",
                "scopeName": "source.mcfunction",
                "path": "./syntaxes/mcfunction.tmLanguage.json"
            },
            {
                "language": "mcflow",
                "scopeName": "source.mcflow",
                "path": "./syntaxes/mcfunction.tmLanguage.json"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "mcflow_number",
                "description": "A number"
            },
            {
                "id": "mcflow_string",
                "description": "A string"
            },
            {
                "id": "mcflow_command",
                "description": "An name of command"
            },
            {
                "id": "mcflow_identifier",
                "description": "An identifier"
            },
            {
                "id": "mcflow_boolean",
                "description": "A boolean"
            },
            {
                "id": "mcflow_parameter",
                "description": "A parameter"
            },
            {
                "id": "mcflow_literal",
                "description": "A literal node"
            },
            {
                "id": "mcflow_label",
                "description": "A label"
            },
            {
                "id": "mcflow_selector_type",
                "description": "A type of selector"
            },
            {
                "id": "mcflow_symbol",
                "description": "A symbol"
            },
            {
                "id": "mcflow_enum",
                "description": "An entry of enum"
            },
            {
                "id": "mcflow_comment",
                "description": "A comment"
            },
            {
                "id": "mcflow_error",
                "description": "An error"
            }
        ],
        "themes": [],
        "configurationDefaults": {
            "[mcfunction]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.bracketPairColorization.enabled": true
            },
            "[mcflow]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.bracketPairColorization.enabled": true
            },
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "mcflow_literal": "#47a2ed",
                    "mcflow_command": "#cc85c6",
                    "mcflow_string": "#cd9069",
                    "mcflow_number": "#b4cda8",
                    "mcflow_boolean": "#b4cda8",
                    "mcflow_parameter": "#8cd7ff",
                    "mcflow_selector_type": "#47ccb1",
                    "mcflow_symbol": "#e58a8a",
                    "mcflow_error": "#f44747",
                    "mcflow_enum": "#4fc1ff",
                    "mcflow_comment": "#699859",
                    "mcflow_identifier": "#e6e6aa"
                }
            }
        }
    },
    "scripts": {
        "build": "tsc"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "typescript": "^7.0.2",
        "@types/bun": "latest"
    }
}
